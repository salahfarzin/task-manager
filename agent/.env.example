# LLM — pick one provider and set the matching key + model string
# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=anthropic/claude-sonnet-4-5

# OpenAI (optional fallback)
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Paths
REPO_PATH=/absolute/path/to/task-manager
AIDER_PATH=aider

# Agent service
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# Pipeline limits
MAX_IMPLEMENT_RETRIES=3

# Logging
# LOG_PATH: where to write log files (relative to agent/ or absolute)
#           default: storage/logs
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR  (default: INFO)
#   agent.log  — messages at LOG_LEVEL and above, daily rotation, 30-day retention
#   error.log  — ERROR and above only, always on, same rotation
LOG_PATH=storage/logs
LOG_LEVEL=INFO
