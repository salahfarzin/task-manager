# LLM — pick one provider and set the matching key + model string
# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=anthropic/claude-sonnet-4-5

# OpenAI (optional fallback)
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Paths
REPO_PATH=/absolute/path/to/task-manager
AIDER_PATH=aider

# Agent service
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# Pipeline limits
MAX_IMPLEMENT_RETRIES=3

# Logging — logs written to agent/storage/logs/agent.log (daily rotation)
# Set to true to also capture DEBUG-level messages in the log file
LOG_DEBUG=false
